# Optional: keras backend for inference (torch | tensorflow)
KERAS_BACKEND=torch

# Hugging Face model repo (public), e.g. your-username/rice-leaf-disease-model
# Required for Cloud Run / Streamlit Cloud when models/ is not bundled in the image.
HF_MODEL_REPO=

# Optional: remote FastAPI URL for Streamlit to call (after Cloud Run deploy)
API_BASE_URL=
